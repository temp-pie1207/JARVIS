# ============================================================
#  JARVIS — Configuration & API Keys
# ============================================================

# 1. OpenAI Configuration (Used as the core reasoning & tool calling LLM)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# Optional custom endpoint (e.g. for Ollama / vLLM / Azure / OpenRouter):
# OPENAI_BASE_URL=https://api.openai.com/v1

# 2. ElevenLabs Configuration (High-quality voice output & Conversational AI)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Conversational AI Agent ID (Byte - Local Desktop Assistant)
ELEVENLABS_AGENT_ID=agent_3101m6rqhcqsf7h9mcg1rkf25g0q
# Voice ID (Default is Adam/George - British/Deep conversational voice)
ELEVENLABS_VOICE_ID=7b9mYhmnp0y2qSH1FnBL
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# 3. System & Voice Playback
# Set to true to automatically speak out of your computer speakers via mpv/paplay:
PLAY_AUDIO_LOCALLY=true

# Set to true to give JARVIS full system command & file access:
SYSTEM_ACCESS_ENABLED=true
DEFAULT_WORKING_DIR=/home/naman1207
